# ==========================================
# HURMO UZ BACKEND CONFIGURATION
# Скопируй в .env и заполни реальными значениями
# НИКОГДА не коммить .env с реальными секретами!
# ==========================================

# Server Port & Environment
# NOTE: Railway автоматически прокидывает PORT — не задавай вручную в Railway
PORT=5000
NODE_ENV=development

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:3000
REDIS_URL=redis://redis:6379
GOOGLE_SHEET_CALLS=
GOOGLE_SHEET_CALLS_TAB=calls
CALL_BATCH_SIZE=50
CALL_BATCH_DELAY_MS=2000

# AUTHENTICATION
# PostgreSQL stores the administrator and created accounts permanently on Railway.
AUTH_STORAGE=postgres
FIXED_USERS=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ADMIN_PASSWORD

# ── SECURITY ──────────────────────────────────────────────────────
# JWT signing secret — must be at least 32 random characters
# Generate: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_EXPIRES_IN=7d

# ── DATABASE (PostgreSQL) ──────────────────────────────────────────
# Note: If PostgreSQL is not connected, the server uses in-memory fallback
DB_ENABLED=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hurmo_dashboard
DB_HOST=localhost
# Railway can also provide PGHOST/PGPORT/PGUSER/PGPASSWORD/PGDATABASE automatically.
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=hurmo_dashboard
DB_SSL=true
DB_ENABLED=true

# ── TELEGRAM BOT (MULTI-ACCOUNT SUPPORT) ───────────────────────────
# Получить токен у @BotFather в Telegram
# НИКОГДА не публиковать токен в коде, README или публичных файлах!
#
# Multi-account format (Railway-style):
# TELEGRAM_TOKEN_1=your_first_bot_token
# TELEGRAM_USER_ID_1=5879131172
# TELEGRAM_TOKEN_2=your_second_bot_token
# TELEGRAM_USER_ID_2=your_second_user_id
# ... (add TELEGRAM_TOKEN_3, TELEGRAM_USER_ID_3, etc. for more accounts)
#
# Legacy single-bot format (still supported for backward compatibility):
# TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_FROM_BOTFATHER
# TELEGRAM_USER_ID=777000
#
# Global admin IDs (apply to all bots)
TELEGRAM_ADMIN_IDS=
# Optional explicit allowlist for all bots
TELEGRAM_ALLOWED_IDS=
# AES-256-GCM key for database-managed bot tokens.
# Generate with: openssl rand -base64 32
TELEGRAM_ENCRYPTION_KEY=

# Todoist is the primary task source when configured. Revoke any token shared in chat.
TODOIST_API_TOKEN=

# Google Calendar OAuth 2.0 (keep all three values in Railway only)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/api/calendar/callback

# ── GOOGLE SHEETS & SERVICE ACCOUNT ───────────────────────────────
# ID из URL таблицы: https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
GOOGLE_SHEET_MAIN=YOUR_SHEET_ID_HERE
GOOGLE_SHEET_NUMBERS=YOUR_SHEET_ID_HERE
GOOGLE_SHEET_ESKIZ=YOUR_SHEET_ID_HERE
GOOGLE_SHEET_NOT_COMPLETED=YOUR_SHEET_ID_HERE
GOOGLE_SHEET_SURVEY_ATTEMPTS=YOUR_SHEET_ID_HERE

# Сервисный аккаунт Google (должен иметь доступ Viewer к таблицам выше)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ── GEMINI AI API ──────────────────────────────────────────────────
# Получить ключ: https://aistudio.google.com/apikey
# Используется бэкендом для /api/ai/chat и /api/ai/insights
# При исчерпании квоты бэкенд сам переключается на следующий ключ.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=

# ── STATUS CLASSIFIER ─────────────────────────────────────────────
# Optional OpenAI-compatible fallback can be added later; Gemini is used first.
STATUS_CLASSIFICATION_QUEUE_NAME=status-classifications
STATUS_CLASSIFICATION_BATCH_SIZE=20
STATUS_CLASSIFICATION_BATCH_DELAY_MS=1000
# Optional OpenAI-compatible fallback (Gemini remains first provider).
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=gpt-4o-mini
