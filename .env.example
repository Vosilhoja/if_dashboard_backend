# ==========================================
# HURMO UZ DASHBOARD & BACKEND CONFIGURATION
# Скопируй в .env и заполни реальными значениями
# НИКОГДА не коммить .env с реальными секретами!
# ==========================================

# Server Port & Environment
PORT=5000
NODE_ENV=development

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:3000

# Security Secrets (Generate unique 64-char keys in production)
# openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING
JWT_EXPIRES_IN=7d

# Database Configuration (PostgreSQL)
# Note: If PostgreSQL is not connected, the server gracefully initializes in-memory fallback
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hurmo_dashboard
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=hurmo_dashboard
DB_SSL=false

# Telegram Bot Integration
# Получить токен у @BotFather в Telegram
# НИКОГДА не публиковать токен в коде, README или публичных файлах!
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_FROM_BOTFATHER
# Telegram Chat IDs or User IDs that are designated as Admin (comma-separated)
TELEGRAM_ADMIN_IDS=

# ==========================================
# GOOGLE SHEETS & SERVICE ACCOUNT CREDENTIALS
# ==========================================
GOOGLE_SHEET_MAIN=YOUR_SHEET_ID_HERE
GOOGLE_SHEET_NUMBERS=YOUR_SHEET_ID_HERE
GOOGLE_SHEET_ESKIZ=YOUR_SHEET_ID_HERE
GOOGLE_SHEET_NOT_COMPLETED=YOUR_SHEET_ID_HERE

GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
